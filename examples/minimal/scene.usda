#usda 1.0
(
    defaultPrim = "world"
    metersPerUnit = 1
    upAxis = "Y"
)
def Xform "world"
{
    def Camera "cam"
    {
        float focalLength = 50
        float horizontalAperture = 41.4214
        float verticalAperture = 20.7107
        double3 xformOp:translate = (0, 0, 2.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def DomeLight "dome"
    {
        float inputs:intensity = 1
    }
    def Mesh "plate" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        rel material:binding = </world/M>
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-1, -0.5, 0), (1, -0.5, 0), (1, 0.5, 0), (-1, 0.5, 0)]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (interpolation = "vertex")
        uniform token subdivisionScheme = "none"
    }
    def Material "M" (prepend references = @./marking.mtlx@</MaterialX/Materials/M_marking>)
    {
    }
}
def Scope "Render"
{
    def RenderSettings "rs"
    {
        rel camera = </world/cam>
        int2 resolution = (1024, 512)
    }
}
